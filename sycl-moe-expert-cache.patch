From 241371396e63d841cda01bc4c3f4cb2d3dcd3fa9 Mon Sep 17 00:00:00 2001
From: Aaron <aahladky@gmail.com>
Date: Tue, 28 Jul 2026 20:15:16 -0400
Subject: [PATCH 2/6] moe-cache: wire cache into mul_mat_id, add CLI args, lazy
 init

- Add --moe-cache-bytes, --moe-cache-policy, --moe-cache-admission-misses,
  --moe-cache-prefill-admission CLI args to common/arg.cpp
- Add moe_cache_bytes/policy/admission/prefill to common_params
- Wire CLI args through server.cpp to ggml-sycl globals
- Integrate cache lookup into ggml_sycl_mul_mat_id: on hit, use
  cached device pointer; on miss, fall through to normal compute
- Lazy-init cache on first mul_mat_id call using tensor geometry
- Cache initializes per-device with SYCL USM allocations
- Tested on host: cache initializes on both GPUs (2383 slots each,
  1 GiB budget, 450560 bytes/expert for Qwen3.5-35B)
---
 common/arg.cpp                   |  34 ++++++++
 common/common.h                  |   6 ++
 ggml/src/ggml-sycl/ggml-sycl.cpp | 141 +++++++++++++++++++++++++++++++
 tools/server/server.cpp          |  14 +++
 4 files changed, 195 insertions(+)

diff --git a/common/arg.cpp b/common/arg.cpp
index 9c5925103..75665a654 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -2530,6 +2530,40 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             }
         }
     ).set_env("LLAMA_ARG_N_CPU_MOE"));
+    add_opt(common_arg(
+        {"--moe-cache-bytes"}, "N",
+        "per-GPU budget in bytes for MoE expert cache (0 = disabled)",
+        [](common_params & params, const std::string & value) {
+            params.moe_cache_bytes = std::stoull(value);
+        }
+    ));
+    add_opt(common_arg(
+        {"--moe-cache-policy"}, "POLICY",
+        "MoE expert cache eviction policy: lru, slru (default: " + params.moe_cache_policy + ")",
+        [](common_params & params, const std::string & value) {
+            if (value != "lru" && value != "slru") {
+                throw std::invalid_argument("invalid policy, expected lru or slru");
+            }
+            params.moe_cache_policy = value;
+        }
+    ));
+    add_opt(common_arg(
