++        if (host_src_up && slot.up_bytes > 0) {
++            m_queue->memcpy(
++                (char *)slot.device_ptr + slot.up_offset,
++                host_src_up, slot.up_bytes).wait();
++            total_bytes += slot.up_bytes;
++        }
++        if (host_src_down && slot.down_bytes > 0) {
++            m_queue->memcpy(
